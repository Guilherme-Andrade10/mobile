<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DDS"
            android:textColor="#1B5E20"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Diálogo Diário de Segurança"
            android:textColor="#777777"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="25dp" />

        <LinearLayout
            android:id="@+id/card_dds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DDS DO DIA"
                android:textColor="#2E7D32"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_titulo_dds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Título publicado pelo TST"
                android:textColor="#222222"
                android:textSize="23sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/txt_data_dds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data do DDS"
                android:textColor="#888888"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp" />

            <TextView
                android:id="@+id/txt_conteudo_dds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="O conteúdo publicado pelo Técnico de Segurança aparecerá aqui."
                android:textColor="#444444"
                android:textSize="16sp"
                android:lineSpacingExtra="6dp" />

        </LinearLayout>


        <!-- EMOCIÔMETRO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:padding="20dp"
            android:layout_marginTop="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Como você está se sentindo hoje?"
                android:textColor="#222222"
                android:textSize="19sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sua percepção ajuda a fortalecer a segurança no trabalho."
                android:textColor="#777777"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="3">

                <Button
                    android:id="@+id/btn_bem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="😊\nBem"
                    android:textSize="14sp"
                    android:textColor="#1B5E20"
                    android:backgroundTint="#E8F5E9"
                    android:layout_marginEnd="5dp" />

                <Button
                    android:id="@+id/btn_neutro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="😐\nNeutro"
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:backgroundTint="#F5F5F5"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btn_mal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="😟\nMal"
                    android:textSize="14sp"
                    android:textColor="#B71C1C"
                    android:backgroundTint="#FFEBEE"
                    android:layout_marginStart="5dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/txt_resposta_emociometro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#2E7D32"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="15dp" />

        </LinearLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conteúdo publicado pelo Técnico de Segurança da empresa."
            android:textColor="#888888"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="10dp" />

    </LinearLayout>

</ScrollView>